{
  "manifest_version": 3,
  "name": "Aside Bookmark Sync",
  "version": "0.1.0",
  "description": "Sync bookmarks between local Chromium browsers through a loopback-only companion.",
  "minimum_chrome_version": "120",
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:32145/*"],
  "background": { "service_worker": "dist/service-worker.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aside Bookmark Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:32145"
  }
}
